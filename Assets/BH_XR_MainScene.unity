      m_Calls: []
  m_text: "<b>BTMMP: Telling the Story of Murals</b>\n\nAlisa Hardy\n\n<i>Interactive
    StoryMap</i>\n\nExplore the Black Trauma Memorial Mural Project through a working
    artist\u2019s station centered on a photograph of the Breonna Taylor mural in
    Annapolis, Maryland. Open the StoryMap to learn how community murals preserve
    memory, honor Black lives, and transform public space into a site of remembrance,
    resistance, and collective storytelling."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
